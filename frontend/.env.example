# === Local Development ===
# Not needed locally – next.config.js rewrites /api/* to localhost:8000

# === Netlify Environment Variables ===
# Set these in Netlify Dashboard > Site settings > Environment variables:
#
# BACKEND_URL=https://your-fastapi-backend.example.com
#   Used by netlify.toml and _redirects to proxy /api/* calls to your backend.
#   This is NOT a NEXT_PUBLIC_ var — it stays server-side in redirect rules.
